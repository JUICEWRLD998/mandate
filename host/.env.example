# MANDATE host environment template — copy to .env and fill in real values.

# Tenant API key from https://www.terminal3.io/claim-page (shown once at claim).
T3N_API_KEY=

# Separate claim-page key bound to the agent DID (the contract-owning agent).
AGENT_KEY=

# Data-owner stand-in key (simulates the user whose data the agent manages).
USER_KEY=

# Base URL of the mock rail service (Phase 4). For LIVE testnet runs this
# must be a PUBLIC URL (the enclave runs on the T3N node — loopback egress is
# never reachable): tunnel the local rail, e.g. serveo/localhost.run, and put
# the https URL here. Local unit runs keep http://localhost:8787.
RAIL_URL=http://localhost:8787

# Sealed payment config seeded into z:<tid>:secrets as rail_beneficiary —
# {legal_name, iban, swift} read inside the enclave for the /pay egress
# (Decision D1: the profile schema cannot carry bank fields). Fill with the
# demo fixture values (see tests/e2e-asserts.sh, which holds the canonical
# fixture IBAN). host/.env is gitignored, so the real value never lands in
# the repo.
RAIL_BENEFICIARY=

# Contract-name tail used to build the contract DID on-chain.
CONTRACT_TAIL=mandate-contracts

# API key the rail trusts; seeded into z:<tid>:secrets by seed-secrets.ts.
RAIL_API_KEY=
